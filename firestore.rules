rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedInVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == 'aqurivo@gmail.com' ||
          request.auth.token.email == 'contact@aqurivo.store' ||
          request.auth.token.email == 'support@aqurivo.store' ||
          request.auth.token.email == 'soufshop.online@gmail.com' ||
          request.auth.token.email == 'soufyane2035@gmail.com' ||
          request.auth.token.email == 'souftoolsai@gmail.com'
        );
    }

    // 1. Products: Publicly readable when published; full read/write for verified admins.
    match /products/{productId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 2. Categories: Publicly readable when active; full read/write for verified admins.
    match /categories/{categoryId} {
      allow get, list: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 3. Partner Sources: Publicly readable when active; full read/write for verified admins.
    match /sources/{sourceId} {
      allow get, list: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 4. Editorial Articles: Publicly readable when published; full read/write for verified admins.
    match /articles/{articleId} {
      allow get, list: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 5. Public Site Settings: Publicly readable for 'public'; full read/write for verified admins.
    match /settings/{settingId} {
      allow get: if settingId == 'public' || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // 6. User Profiles: Owner can read/write own profile (cannot escalate role to admin); verified admins can read/manage.
    match /users/{userId} {
      allow get: if (isSignedInVerified() && isValidId(userId) && request.auth.uid == userId) || isAdmin();
      allow create, update: if (
        isSignedInVerified() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'visitor')
      ) || isAdmin();
      allow list, delete: if isAdmin();
    }

    // 7. Contact Messages: Visitors can create bounded messages; admins can read/update/delete.
    match /messages/{messageId} {
      allow create: if isValidId(messageId) &&
        request.resource.data.senderName is string &&
        request.resource.data.senderName.size() >= 2 &&
        request.resource.data.senderName.size() <= 100 &&
        request.resource.data.senderEmail is string &&
        request.resource.data.senderEmail.size() >= 3 &&
        request.resource.data.senderEmail.size() <= 160 &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() >= 2 &&
        request.resource.data.subject.size() <= 160 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 10 &&
        request.resource.data.message.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    // 8. Click Analytics: Server/Visitor click logging with bounded fields + admin analytics read.
    match /clicks/{clickId} {
      allow create: if isValidId(clickId) &&
        request.resource.data.productSlug is string &&
        request.resource.data.productSlug.size() >= 1 &&
        request.resource.data.productSlug.size() <= 160;
      allow read, update, delete: if isAdmin();
    }

    // 9. Amazon PA-API Sync Logs: Admin read/write.
    match /sync_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 10. Visitor Testimonials: Public can read approved testimonials and submit unapproved ones; Admins can read/approve/delete.
    match /testimonials/{testimonialId} {
      allow get, list: if resource.data.approved == true || isAdmin();
      allow create: if request.resource.data.approved == false &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 50 &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() >= 1 &&
        request.resource.data.text.size() <= 300;
      allow update, delete: if isAdmin();
    }

    // 11. Product Reviews: Public can read approved reviews and create valid bounded reviews; admins can manage.
    match /reviews/{reviewId} {
      allow get, list: if resource.data.approved == true || isAdmin();
      allow create: if request.resource.data.userName is string &&
        request.resource.data.userName.size() >= 1 &&
        request.resource.data.userName.size() <= 80 &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.productSlug is string &&
        request.resource.data.productSlug.size() >= 1 &&
        request.resource.data.productSlug.size() <= 160 &&
        (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 300));
      allow update, delete: if isAdmin();
    }

    // 12. Issue & Help Reports: Created via Server API only; read and update restricted to verified admins.
    match /reports/{reportId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // 13. Admin Secrets (Canopy API key pool & rotation state): Restricted to verified admins only.
    match /admin_secrets/{secretId} {
      allow read, write: if isAdmin();
    }
  }
}
