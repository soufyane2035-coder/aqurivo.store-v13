# عنوان الموقع الأساسي بدون شرطة مائلة في النهاية (يُستخدم في SEO وخريطة الموقع وروابط المشاركة)
SITE_URL="https://aqurivo.store"
NEXT_PUBLIC_SITE_URL=https://aqurivo.store
NEXT_PUBLIC_SITE_URL_COM=https://aqurivo.com

# ==============================================================================
# إعدادات إرسال البريد الإلكتروني عبر خادم SMTP (Google Gmail App Password)
# ==============================================================================
# 1. عنوان خادم SMTP لـ Gmail: smtp.gmail.com
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"

# 2. بريد الحساب المرسل (حساب Gmail الاحترافي الخاص بك)
SMTP_USER="souftoolsai@gmail.com"

# 3. كلمة مرور التطبيقات المكونة من 16 حرفاً (Google App Password)
# للحصول عليها: ادخل إلى حساب Google > الأمان > التحقق بخطوتين > كلمات مرور التطبيقات (App Passwords)
# أنشئ كلمة مرور باسم "AQURIVO Website" والصق الـ 16 حرفاً هنا:
SMTP_APP_PASSWORD=""

# 4. البريد الذي يتلقى إشعارات رسائل التواصل والعملاء فورياً (مفصول بفواصل إن وُجد أكثر من بريد)
CONTACT_NOTIFICATION_EMAIL="souftoolsai@gmail.com,contact@aqurivo.store"
SMTP_FROM_NAME="AQURIVO Contact Desk"

# ==============================================================================
# إعدادات Firebase العامة للواجهة (مشروع aqurivostor)
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_DATABASE_URL=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# بيانات حساب خدمة Firebase Admin (للخادم فقط — لا تكشفها للمتصفح أبداً)
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# تظل القيمة firestore حتى الموافقة على التحويل؛ لتفعيل Turso محلياً غيّر المتغيرين معاً
DATA_STORE=firestore
NEXT_PUBLIC_DATA_STORE=firestore
TURSO_DATABASE_URL="
TURSO_AUTH_TOKEN="

# AQURIVO MCP stays read-only unless every applicable gate is explicitly enabled.
AQURIVO_MCP_TARGET=local
AQURIVO_MCP_ENABLE_WRITES=false
AQURIVO_MCP_ALLOW_PRODUCTION_READS=false
AQURIVO_MCP_ALLOW_PRODUCTION_WRITES=false
AQURIVO_MCP_ALLOW_DELETES=false

# مفتاح نسخ احتياطي عشوائي بطول 32 حرفاً على الأقل، منفصل عن رمز Turso
FIRESTORE_BACKUP_ENCRYPTION_KEY=""

# عناوين البريد المؤكدة المسموح لها بدخول لوحة التحكم (مفصولة بفاصلة)
ADMIN_EMAILS="aqurivo@gmail.com,soufyane2035@gmail.com,lrsoufyane2007@gmail.com"

# مفتاح عشوائي سري قوي بطول 32 حرفاً على الأقل (مثلاً: openssl rand -base64 32)
SESSION_COOKIE_SECRET=""

# مفتاح تشفير ثابت لمفاتيح مزودي الذكاء الاصطناعي والأدوات، 32 حرفاً على الأقل
# لا تغيّره بعد حفظ المفاتيح؛ تغيير القيمة يمنع فك تشفير المفاتيح المحفوظة.
AI_SECRETS_ENCRYPTION_KEY=""

# ملح تشفير سري عشوائي لتجزئة عناوين IP باتجاه واحد عند تسجيل النقرات دون تخزين العنوان الحقيقي
IP_HASH_SALT=""

# إعدادات Cloudinary لرفع وعرض صور المنتجات (المفتاح والسر للخادم فقط للتوقيع الآمن)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# إعدادات Amazon Product Advertising API 5.0 (للخادم فقط — لا تضعها في المتصفح أبداً)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
AMAZON_REGION=us-east-1

# مفاتيح Canopy API لجلب بيانات وصور وفيديوهات المنتجات تلقائياً مع نظام التدوير (مفصولة بفاصلة، وتُدار أيضاً من لوحة الإعدادات)
CANOPY_API_KEYS=""

# متغيرات بيئة التشغيل التلقائية في المنصة (تُترك فارغة هنا)
GEMINI_API_KEY=""
APP_URL=""
